---
import { Icon } from "astro-icon/components";

const sections = [
  { id: "about", title: "About", icon: "carbon:identification" },
  { id: "work", title: "Work Experience", icon: "carbon:construction" },
  { id: "education", title: "Education", icon: "carbon:education" },
  { id: "research", title: "Research & Projects", icon: "carbon:tools" },
  { id: "articles", title: "Articles", icon: "carbon:pen" },
  { id: "videos", title: "Videos", icon: "carbon:video" },
  { id: "certificates", title: "Certificates", icon: "carbon:certificate" },
  { id: "files", title: "Files", icon: "carbon:volume-file-storage" },
  { id: "contact", title: "Contact", icon: "carbon:location-person" },
];
---

<!-- Mobile Navigation Toggle -->
<button
  id="nav-toggle"
  class="fixed top-4 left-4 z-50 btn btn-sm btn-circle bg-base-200 border-base-300 hover:bg-base-300 shadow-lg block md:hidden"
  aria-label="Toggle navigation"
>
  <Icon name="carbon:menu" class="w-5 h-5" />
</button>

<!-- Navigation Sidebar -->
<nav
  id="section-nav"
  class="fixed left-0 top-0 h-full w-72 bg-base-200/95 backdrop-blur-sm border-r border-base-300 z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out"
>
  <div class="flex flex-col h-full">
    <!-- Header -->
    <div class="px-4 pb-4 pt-20 md:p-4 border-b border-base-300">
      <h3 class="font-semibold text-base-content">Navigation</h3>
    </div>

    <!-- Navigation Links -->
    <div class="flex-1 overflow-y-auto p-4">
      <ul class="menu menu-sm w-full">
        {
          sections.map((section) => (
            <li class="w-full">
              <a
                href={`#${section.id}`}
                class="nav-link flex items-center gap-4 px-3 py-3 rounded-lg hover:bg-base-300 transition-colors w-full text-left"
                data-section={section.id}
              >
                <Icon name={section.icon} class="w-5 h-5 flex-shrink-0" />
                <span class="text-sm font-medium flex-1 truncate">
                  {section.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Close button for mobile -->
    <div class="p-4 border-t border-base-300 md:hidden">
      <button id="nav-close" class="btn btn-sm btn-outline w-full">
        <Icon name="carbon:close" class="w-4 h-4 mr-2" />
        Close
      </button>
    </div>
  </div>
</nav>

<!-- Overlay for mobile -->
<div
  id="nav-overlay"
  class="fixed inset-0 bg-black/50 z-30 opacity-0 pointer-events-none md:hidden transition-opacity duration-300"
>
</div>

<script>
  // Navigation functionality
  document.addEventListener("DOMContentLoaded", function () {
    const navToggle = document.getElementById("nav-toggle");
    const navClose = document.getElementById("nav-close");
    const nav = document.getElementById("section-nav");
    const overlay = document.getElementById("nav-overlay");
    const navLinks = document.querySelectorAll(".nav-link");

    // Toggle mobile navigation
    function toggleNav() {
      const isOpen = !nav.classList.contains("-translate-x-full");
      if (isOpen) {
        closeNav();
      } else {
        openNav();
      }
    }

    function openNav() {
      nav.classList.remove("-translate-x-full");
      overlay.classList.remove("opacity-0", "pointer-events-none");
    }

    function closeNav() {
      nav.classList.add("-translate-x-full");
      overlay.classList.add("opacity-0", "pointer-events-none");
    }

    // Event listeners
    navToggle?.addEventListener("click", toggleNav);
    navClose?.addEventListener("click", closeNav);
    overlay?.addEventListener("click", closeNav);

    // Handle navigation clicks
    navLinks.forEach((link) => {
      link.addEventListener(
        "click",
        (e) => {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          const sectionId = link.getAttribute("data-section");
          if (!sectionId) return;

          const targetSection = document.getElementById(sectionId);
          if (!targetSection) return;

          // Set navigation flag to prevent observer interference
          isUserNavigating = true;

          // Close mobile nav
          closeNav();

          // Find the accordion element (details element) within the section
          const accordionDetails = targetSection.querySelector("details");

          if (accordionDetails) {
            // Close all other accordions first
            document.querySelectorAll("details").forEach((details) => {
              if (details !== accordionDetails) {
                details.removeAttribute("open");
              }
            });

            // Always open the target accordion
            accordionDetails.setAttribute("open", "");
          }

          // Update active state immediately
          updateActiveLink(sectionId);

          // Smooth scroll to section with offset for fixed nav
          setTimeout(() => {
            const yOffset = window.innerWidth >= 768 ? -20 : -80;
            const y =
              targetSection.getBoundingClientRect().top +
              window.pageYOffset +
              yOffset;

            window.scrollTo({
              top: y,
              behavior: "smooth",
            });

            // Reset navigation flag after scrolling completes
            setTimeout(() => {
              isUserNavigating = false;
            }, 1000);
          }, 100);
        },
        { once: false, passive: false }
      );
    });

    // Update active navigation link
    function updateActiveLink(activeId) {
      navLinks.forEach((link) => {
        const isActive = link.getAttribute("data-section") === activeId;
        link.classList.toggle("bg-primary", isActive);
        link.classList.toggle("text-primary-content", isActive);
      });
    }

    // Intersection Observer for auto-highlighting active section
    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -70% 0px",
      threshold: 0.1,
    };

    let isUserNavigating = false;

    const observer = new IntersectionObserver((entries) => {
      // Don't update active links if user is actively navigating
      if (isUserNavigating) return;

      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActiveLink(entry.target.id);
        }
      });
    }, observerOptions);

    // Observe all sections
    const sectionIds = [
      "about",
      "work",
      "education",
      "research",
      "articles",
      "videos",
      "certificates",
      "files",
      "contact",
    ];
    document.querySelectorAll("[id]").forEach((section) => {
      if (section.id && sectionIds.includes(section.id)) {
        observer.observe(section);
      }
    });
  });
</script>

<style>
  /* Ensure nav is above other content */
  #section-nav {
    z-index: 40;
  }

  /* Mobile nav toggle positioning */
  #nav-toggle {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  #nav-toggle:hover {
    transform: translateY(-1px);
    box-shadow:
      0 6px 8px -1px rgba(0, 0, 0, 0.15),
      0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Navigation links styling */
  .nav-link {
    min-height: 48px;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    text-align: left !important;
    white-space: nowrap;
    width: 100%;
    box-sizing: border-box;
  }

  .nav-link span {
    flex: 1;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0; /* Allows flex item to shrink below content size */
  }

  /* Smooth scrolling for the entire page */
  html {
    scroll-behavior: smooth;
  }

  /* Adjust main content margin on desktop */
  @media (min-width: 768px) {
    .main-with-nav {
      margin-left: 18rem; /* 288px / 16 = 18rem for w-72 */
    }
  }

  /* Hide mobile menu button on desktop */
  @media (min-width: 768px) {
    #nav-toggle {
      display: none !important;
    }
  }

  /* Mobile navigation improvements */
  @media (max-width: 767px) {
    #section-nav {
      width: 320px; /* Wider for better text spacing */
    }

    .nav-link {
      padding: 0.75rem 1rem !important;
      gap: 1rem !important;
    }

    .nav-link span {
      font-size: 0.875rem;
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
