---
import { Icon } from "astro-icon/components";
import * as about from "../pages/about/about.md";
---

<header class="mx-auto pt-6 pb-2 relative">
  <article
    class="flex flex-col items-center gap-6 w-full max-w-2xl mx-auto text-center"
  >
    <!-- Profile Image -->
    <div
      class="flex-shrink-0 w-24 md:w-28 lg:w-32 rounded-full shadow-lg overflow-hidden ring-4 ring-base-300"
    >
      <img
        alt="Dilan Jayamanne Profile Picture"
        src="/profile_pic4.png"
        class="w-full h-full object-cover grayscale-[50] hover:grayscale-0 transition-all duration-300"
      />
    </div>

    <!-- Profile Information -->
    <div class="text-center space-y-3">
      <!-- Name and Pronouns -->
      <div class="relative">
        <h1
          class="text-3xl md:text-4xl font-extrabold tracking-tight text-base-content"
        >
          {about.frontmatter.name}
        </h1>
        <div class="mt-2">
          <div class="badge badge-outline badge-sm font-light shadow-sm">
            {about.frontmatter.pronouns}
          </div>
        </div>
      </div>

      <!-- Designation -->
      <h2 class="text-lg md:text-xl font-bold text-base-content">
        {about.frontmatter.designation}
      </h2>

      <!-- Location -->
      <div class="flex items-center justify-center gap-2 text-base-content/70">
        <Icon name="carbon:location" class="w-4 h-4" />
        <p class="text-sm md:text-base">{about.frontmatter.location}</p>
      </div>

      <!-- Contact Information -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-base-content/70">
        <!-- Phone -->
        <div class="flex items-center gap-2">
          <Icon name="carbon:phone" class="w-4 h-4" />
          <div class="flex items-center gap-2 text-sm">
            <a href="tel:+971502663976" class="hover:text-primary transition-colors">+971 50 266 3976</a>
            <span>|</span>
            <a href="https://wa.me/971502663976" target="_blank" class="hover:text-primary transition-colors">
              WhatsApp
            </a>
          </div>
        </div>
        
        <!-- Email -->
        <div class="flex items-center gap-2">
          <Icon name="carbon:email" class="w-4 h-4" />
          <a href="mailto:dicmandilan@gmail.com" class="text-sm hover:text-primary transition-colors">
            dicmandilan@gmail.com
          </a>
        </div>
      </div>
    </div>
  </article>
</header>

<style>
  /* Responsive adjustments */
  @media (max-width: 768px) {
    header {
      padding-top: 4rem; /* Account for mobile nav button */
    }
  }

  /* Smooth transitions */
  .badge {
    transition: all 0.3s ease;
  }

  .badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }
</style>
