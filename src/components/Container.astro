---
import { Icon } from "astro-icon/components";
import AccordionLayout from "../layouts/AccordionLayout.astro";
import * as about from "../pages/about/about.md";
import Card from "./Card.astro";
import ContactCard from "./ContactCard.astro";
const works = await Astro.glob("../pages/works/*.md");
const projects = await Astro.glob("../pages/projects/*.md");
const research = await Astro.glob("../pages/research/*.md");
const studies = await Astro.glob("../pages/studies/*.md");
const certificates = await Astro.glob("../pages/certificates/*.md");
const articles = await Astro.glob("../pages/articles/*.md");
const contact = await Astro.glob("../pages/contact/*.md");
const PDF = "/cv_dilan_jayamanne.pdf";
---

<div class="join join-vertical gap-1 w-full">
  <div id="about">
    <AccordionLayout title={"About"} icon={"carbon:identification"}>
      <article class="text-justify">
        <Fragment set:html={about.compiledContent()} />
      </article>
    </AccordionLayout>
  </div>

  <div id="work">
    <AccordionLayout title={"Work Experience"} icon={"carbon:construction"}>
    {
      works.map((item) => {
        return (
          <Card
            title={item.frontmatter.title}
            timeframe={item.frontmatter.date}
            description={item.compiledContent()}
            tags={item.frontmatter.tags}
            url={item.frontmatter.url}
            url_name={item.frontmatter.org}
            location={item.frontmatter.location}
          />
        );
      })
    }
    </AccordionLayout>
  </div>

  <div id="education">
    <AccordionLayout title={"Education"} icon={"carbon:education"}>
    {
      studies.map((item) => {
        return (
          <Card
            title={item.frontmatter.title}
            timeframe={item.frontmatter.date}
            location={item.frontmatter.location}
            tags={item.frontmatter.tags}
            url={item.url}
            url_name={item.frontmatter.institute}
          />
        );
      })
    }
    </AccordionLayout>
  </div>

  <div id="research">
    <AccordionLayout title={"Research & Projects"} icon={"carbon:tools"}>
    {
      research.map((item) => {
        return (
          <Card
            title={item.frontmatter.title}
            timeframe={item.frontmatter.date}
            description={item.compiledContent()}
            tags={item.frontmatter.tags}
            url={item.frontmatter.url}
            url_name={"View Research"}
          />
        );
      })
    }
    {
      projects.map((item) => {
        return (
          <Card
            title={item.frontmatter.title}
            timeframe={item.frontmatter.date}
            description={item.compiledContent()}
            tags={item.frontmatter.tags}
            url={item.frontmatter.url}
            url_name={"View Project"}
          />
        );
      })
    }
    </AccordionLayout>
  </div>

  <div id="articles">
    <AccordionLayout title={"Articles & Publications"} icon={"carbon:pen"}>
    {
      articles.map((item) => {
        return (
          <Card
            title={item.frontmatter.title}
            timeframe={item.frontmatter.date}
            description={item.compiledContent()}
            tags={item.frontmatter.tags}
            url={item.frontmatter.url}
            url_name={item.frontmatter.url_name}
          />
        );
      })
    }
    </AccordionLayout>
  </div>

  <div id="videos">
    <AccordionLayout title={"YouTube Videos"} icon={"carbon:video"}>
      <div class="space-y-4">
        <!-- Git Tutorials Playlist -->
        <Card
          title="Git Tutorials"
          description="Comprehensive Git tutorials covering version control fundamentals and advanced concepts."
          url="https://youtube.com/playlist?list=PLxB11SRdpr7MXr2RsNoFmz2xyNcWihRHv&si=kVp6yx_M-HImLSWl"
          url_name="Watch Playlist"
        />
        
        <!-- Rust Tutorials and Demos Playlist -->
        <Card
          title="Rust Tutorials and Demos"
          description="Learn Rust programming with practical tutorials and real-world demonstrations."
          url="https://youtube.com/playlist?list=PLxB11SRdpr7ObNblzwQ0hqJhkmlc04wHb&si=5SN2Xq5L0TO2sPe2"
          url_name="Watch Playlist"
        />
        
        <!-- More Videos -->
        <Card
          title="More Videos"
          description="Explore additional tech content and tutorials on my YouTube channel."
          url="https://www.youtube.com/@DilanTech/videos"
          url_name="View All Videos"
        />
      </div>
    </AccordionLayout>
  </div>

  <!-- <div id="certificates">
    <AccordionLayout title={"Certifications"} icon={"carbon:certificate"}>
    {
      certificates.map((item) => {
        return (
          <Card
            title={item.frontmatter.title}
            timeframe={item.frontmatter.date}
            description={item.compiledContent()}
            tags={item.frontmatter.tags}
            url={item.frontmatter.url}
            url_name={"View Certificate"}
          />
        );
      })
    }
    </AccordionLayout>
  </div> -->

  <div id="files">
    <AccordionLayout title={"CV/Resume"} icon={"carbon:document"}>
    <div class="flex justify-center w-full">
      <div
        class="card card-compact card-bordered border-[oklch(var(--s))] w-96 md:w-112 lg:w-128 hover:shadow-lg transition-all"
      >
        <figure>
          <object data={PDF} type="application/pdf" width="100%"></object>
        </figure>
        <div class="card-body">
          <h2 class="card-title">Resume</h2>
          <p>View and download my latest resume highlighting 3+ years of Rust/Python development experience</p>
          <div class="card-actions justify-end">
            <a target="_blank" href={PDF}>
              <button class="btn btn-outline">
                <p>Download resume</p>
                <Icon name="carbon:document-pdf" class="w-6 h-6 ml-1" />
              </button>
            </a>
          </div>
        </div>
      </div>
    </div>
    </AccordionLayout>
  </div>

  <div id="contact">
    <AccordionLayout title={"Contact"} icon={"carbon:location-person"}>
    <div class="flex flex-wrap content-around gap-4 justify-center">
      {
        contact.map((item) => {
          return (
            <ContactCard
              url={item.frontmatter.url}
              url_name={item.frontmatter.title}
              icon={item.frontmatter.icon}
            />
          );
        })
      }
    </div>
    </AccordionLayout>
  </div>
</div>
