---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="DilanJT - Backend Developer & Tech Enthusiast" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #ffffff;
        background-color: #000000;
        overflow-x: hidden;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      .section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 4rem 0;
      }

      .section:not(:last-child) {
        border-bottom: 1px solid #333;
      }

      h1, h2, h3 {
        font-weight: 300;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(3rem, 8vw, 6rem);
        line-height: 1;
      }

      h2 {
        font-size: clamp(2rem, 5vw, 3rem);
        margin-bottom: 2rem;
      }

      h3 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }

      a {
        color: #ffffff;
        text-decoration: none;
        transition: opacity 0.2s ease;
      }

      a:hover {
        opacity: 0.7;
      }

      .nav {
        position: fixed;
        top: 2rem;
        right: 2rem;
        z-index: 1000;
        display: flex;
        gap: 2rem;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .footer {
        padding: 4rem 0;
        border-top: 1px solid #333;
        text-align: center;
        font-size: 0.9rem;
      }

      .footer nav {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
      }

      @media (max-width: 768px) {
        .container {
          padding: 0 1rem;
        }
        
        .nav {
          top: 1rem;
          right: 1rem;
          gap: 1rem;
        }
        
        .footer nav {
          flex-direction: column;
          gap: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/cv">CV</a>
      <a href="/gallery">Gallery</a>
    </nav>
    
    <main>
      <slot />
    </main>
    
    <footer class="footer">
      <div class="container">
        <nav>
          <a href="#home">Home</a>
          <a href="#articles">Articles</a>
          <a href="#projects">Projects</a>
          <a href="#achievements">Achievements</a>
          <a href="/cv">CV</a>
          <a href="/gallery">Gallery</a>
        </nav>
        <p>&copy; 2025 DilanJT.</p>
      </div>
    </footer>
  </body>
</html>