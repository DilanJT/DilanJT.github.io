---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DilanJT - CV">
  <section class="section">
    <div class="container">
      <div class="cv-header">
        <h1>Curriculum Vitae</h1>
        <div class="cv-actions">
          <button onclick="window.print()" class="print-btn">Print CV</button>
          <a href="/cv.pdf" download class="download-btn">Download PDF</a>
        </div>
      </div>

      <div class="cv-content">
        <div class="cv-section">
          <h2>DilanJT</h2>
          <p class="cv-title">Backend Developer & Tech Enthusiast</p>
          <div class="contact-info">
            <p>Email: dilan@example.com</p>
            <p>GitHub: github.com/DilanJT</p>
            <p>LinkedIn: linkedin.com/in/dilanjt</p>
          </div>
        </div>

        <div class="cv-section">
          <h3>Technical Expertise</h3>
          <div class="skills-grid">
            <div class="skill-category">
              <h4>Languages</h4>
              <p>Rust, Python, C++, TypeScript</p>
            </div>
            <div class="skill-category">
              <h4>Databases</h4>
              <p>PostgreSQL, Redis, MongoDB</p>
            </div>
            <div class="skill-category">
              <h4>Protocols</h4>
              <p>Bluetooth LE, gRPC, REST, WebSocket</p>
            </div>
            <div class="skill-category">
              <h4>Infrastructure</h4>
              <p>Docker, Kubernetes, AWS, Linux</p>
            </div>
          </div>
        </div>

        <div class="cv-section">
          <h3>Professional Experience</h3>
          <div class="experience-item">
            <h4>Senior Backend Developer</h4>
            <p class="company-period">Tech Innovations Inc. • 2022 - Present</p>
            <ul>
              <li>Architected and developed high-performance microservices in Rust handling 100k+ requests/second</li>
              <li>Led migration from Python to Rust, achieving 300% performance improvement</li>
              <li>Implemented Bluetooth mesh networking protocols for IoT device communication</li>
              <li>Optimized PostgreSQL queries reducing response time by 60%</li>
            </ul>
          </div>
          <div class="experience-item">
            <h4>Backend Developer</h4>
            <p class="company-period">StartupXYZ • 2020 - 2022</p>
            <ul>
              <li>Built scalable Python-based data processing pipeline handling millions of events daily</li>
              <li>Developed real-time analytics system using Apache Kafka and PostgreSQL</li>
              <li>Implemented ML integration for predictive analytics features</li>
            </ul>
          </div>
        </div>

        <div class="cv-section">
          <h3>Research & Publications</h3>
          <div class="publication-item">
            <h4>"Optimized Bluetooth Mesh Protocols for Industrial IoT"</h4>
            <p class="publication-details">IEEE Internet of Things Conference 2024</p>
          </div>
          <div class="publication-item">
            <h4>"Performance Analysis of Rust in High-Frequency Trading Systems"</h4>
            <p class="publication-details">ACM Systems Conference 2023</p>
          </div>
        </div>

        <div class="cv-section">
          <h3>Education</h3>
          <div class="education-item">
            <h4>Master of Science in Computer Science</h4>
            <p class="institution-period">University of Technology • 2018 - 2020</p>
            <p>Thesis: "Distributed Systems Performance Optimization"</p>
          </div>
          <div class="education-item">
            <h4>Bachelor of Engineering in Software Engineering</h4>
            <p class="institution-period">Tech University • 2014 - 2018</p>
            <p>First Class Honours</p>
          </div>
        </div>

        <div class="cv-section">
          <h3>Key Achievements</h3>
          <ul class="achievements-list">
            <li>Core contributor to open source Rust libraries with 10k+ GitHub stars combined</li>
            <li>Speaker at RustConf 2024 on "Building Ultra-Fast Backend Services"</li>
            <li>Winner of International Bluetooth Innovation Challenge 2023</li>
            <li>Led team of 8 developers in successful system migration project</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #333;
  }

  .cv-actions {
    display: flex;
    gap: 1rem;
  }

  .print-btn, .download-btn {
    padding: 0.75rem 1.5rem;
    border: 1px solid #333;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    text-decoration: none;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }

  .print-btn:hover, .download-btn:hover {
    background-color: #ffffff;
    color: #000000;
  }

  .cv-content {
    max-width: 800px;
  }

  .cv-section {
    margin-bottom: 3rem;
  }

  .cv-section h2 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .cv-section h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #333;
  }

  .cv-section h4 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .cv-title {
    font-size: 1.5rem;
    color: #ccc;
    margin-bottom: 1rem;
  }

  .contact-info {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .contact-info p {
    color: #888;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .skill-category h4 {
    color: #ffffff;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .skill-category p {
    color: #ccc;
    font-size: 0.9rem;
  }

  .experience-item, .education-item, .publication-item {
    margin-bottom: 2rem;
  }

  .company-period, .institution-period, .publication-details {
    color: #888;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .experience-item ul, .achievements-list {
    margin-left: 1.5rem;
    margin-top: 0.5rem;
  }

  .experience-item li, .achievements-list li {
    margin-bottom: 0.5rem;
    color: #ccc;
  }

  @media print {
    .cv-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .cv-actions {
      display: none;
    }
    
    .section {
      min-height: auto;
      padding: 1rem 0;
    }
    
    body {
      color: #000000;
      background-color: #ffffff;
    }
    
    .cv-section h3 {
      border-bottom-color: #333;
    }
  }

  @media (max-width: 768px) {
    .cv-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .contact-info {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>