---
import Layout from '../layouts/Layout.astro';

const timelineData = [
  {
    year: 2025,
    title: "IEEE Conference Publication",
    description: "Published research on Bluetooth Mesh Protocols for Industrial IoT",
    type: "publication"
  },
  {
    year: 2024,
    title: "RustConf Speaker",
    description: "Presented 'Building Ultra-Fast Backend Services' to 500+ developers",
    type: "speaking"
  },
  {
    year: 2024,
    title: "Senior Backend Developer",
    description: "Promoted to lead Rust architecture initiatives at Tech Innovations Inc.",
    type: "career"
  },
  {
    year: 2023,
    title: "Bluetooth Innovation Challenge Winner",
    description: "Won international competition for novel mesh networking solution",
    type: "achievement"
  },
  {
    year: 2023,
    title: "Open Source Milestone",
    description: "Rust libraries reached 10k+ GitHub stars combined",
    type: "project"
  },
  {
    year: 2022,
    title: "Career Transition",
    description: "Joined Tech Innovations Inc. as Backend Developer",
    type: "career"
  },
  {
    year: 2021,
    title: "Performance Breakthrough",
    description: "Achieved 300% system performance improvement through Rust migration",
    type: "achievement"
  },
  {
    year: 2020,
    title: "Master's Degree Completed",
    description: "M.S. in Computer Science - Distributed Systems Performance Optimization",
    type: "education"
  },
  {
    year: 2020,
    title: "First Backend Role",
    description: "Started as Backend Developer at StartupXYZ",
    type: "career"
  },
  {
    year: 2019,
    title: "Research Foundation",
    description: "Began research into high-performance computing and systems optimization",
    type: "research"
  }
];
---

<Layout title="DilanJT - Gallery & Timeline">
  <section class="section">
    <div class="container">
      <div class="gallery-header">
        <h1>Journey Timeline</h1>
        <p class="timeline-subtitle">A chronological view of milestones, achievements, and growth from 2019 to 2025</p>
      </div>

      <div class="timeline">
        {timelineData.map((item, index) => (
          <div class="timeline-item" data-year={item.year} data-type={item.type}>
            <div class="timeline-marker">
              <span class="timeline-year">{item.year}</span>
            </div>
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="timeline-type">{item.type}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="gallery-stats">
        <div class="stat-item">
          <h3>7</h3>
          <p>Years of Growth</p>
        </div>
        <div class="stat-item">
          <h3>10+</h3>
          <p>Major Milestones</p>
        </div>
        <div class="stat-item">
          <h3>3</h3>
          <p>Career Transitions</p>
        </div>
        <div class="stat-item">
          <h3>2</h3>
          <p>Research Publications</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gallery-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gallery-header h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: 1rem;
  }

  .timeline-subtitle {
    font-size: 1.2rem;
    color: #888;
    max-width: 600px;
    margin: 0 auto;
  }

  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto 4rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: #333;
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
  }

  .timeline-item:nth-child(odd) {
    flex-direction: row;
  }

  .timeline-item:nth-child(even) {
    flex-direction: row-reverse;
  }

  .timeline-marker {
    position: relative;
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border: 1px solid #333;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
    z-index: 2;
  }

  .timeline-year {
    font-size: 1.2rem;
    font-weight: 300;
    color: #ffffff;
  }

  .timeline-content {
    flex: 1;
    padding: 2rem;
    border: 1px solid #333;
    margin: 0 2rem;
    background-color: #000;
    transition: border-color 0.2s ease;
  }

  .timeline-content:hover {
    border-color: #666;
  }

  .timeline-content h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    color: #ffffff;
  }

  .timeline-content p {
    color: #ccc;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .timeline-type {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: #111;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888;
  }

  .timeline-type {
    background-color: #111;
  }

  [data-type="publication"] .timeline-type {
    background-color: #1a1a2e;
    color: #7c7ce0;
  }

  [data-type="speaking"] .timeline-type {
    background-color: #1a2e1a;
    color: #7ce07c;
  }

  [data-type="career"] .timeline-type {
    background-color: #2e1a1a;
    color: #e07c7c;
  }

  [data-type="achievement"] .timeline-type {
    background-color: #2e2e1a;
    color: #e0e07c;
  }

  [data-type="project"] .timeline-type {
    background-color: #1a2e2e;
    color: #7ce0e0;
  }

  [data-type="education"] .timeline-type {
    background-color: #2e1a2e;
    color: #e07ce0;
  }

  [data-type="research"] .timeline-type {
    background-color: #1a1a1a;
    color: #cccccc;
  }

  .gallery-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .stat-item {
    padding: 2rem 1rem;
    border: 1px solid #333;
  }

  .stat-item h3 {
    font-size: 2.5rem;
    font-weight: 300;
    margin-bottom: 0.5rem;
    color: #ffffff;
  }

  .stat-item p {
    color: #888;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .timeline::before {
      left: 50px;
    }

    .timeline-item {
      flex-direction: row !important;
    }

    .timeline-item:nth-child(even) {
      flex-direction: row !important;
    }

    .timeline-marker {
      width: 60px;
      height: 60px;
      margin-left: 20px;
    }

    .timeline-year {
      font-size: 1rem;
    }

    .timeline-content {
      margin: 0 1rem;
    }

    .gallery-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .gallery-stats {
      grid-template-columns: 1fr;
    }
  }
</style>